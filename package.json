{
  "name": "p3-cedula",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "start:simulate": "cross-env PAYMENT_SIMULATE=true PORT=3001 node ./bin/www",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "build": "npm run build-client && echo 'Build completed'",
    "build-client": "node ./scripts/build-client.js",
    "test:watch": "jest --watch",
    "db:sync": "node scripts/sync-db.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.1.4",
    "express": "~4.16.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "jest-mock": "^30.2.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "sequelize-mock": "^0.10.2",
    "supertest": "^6.3.3",
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
